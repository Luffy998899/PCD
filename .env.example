# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute public origin, no trailing slash. Used for canonical URLs, sitemap,
# robots.txt and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "development" | "staging" | "production"
# Placeholder content ([CLIENT TO PROVIDE] markers) is only rendered when this
# is NOT "production". Set to "production" for any public deployment.
NEXT_PUBLIC_APP_ENV=development

# Set to 1 to fill every page with a fictional demo company, so the site can be
# reviewed before real content exists. Ignored when NEXT_PUBLIC_APP_ENV is
# "production" — demo content can never reach a live site.
NEXT_PUBLIC_DEMO_MODE=0

# ---------------------------------------------------------------------------
# Supabase (database, auth, storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used by trusted server actions and
# admin operations that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Transactional email (Resend-compatible HTTP API)
# ---------------------------------------------------------------------------
# When unset, enquiry notifications are logged instead of sent. Submissions are
# still persisted to the database.
RESEND_API_KEY=
MAIL_FROM="PCD Pharma Website <website@example.com>"
# Comma-separated internal recipients for enquiry notifications.
MAIL_ENQUIRY_RECIPIENTS=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Contact channels
# ---------------------------------------------------------------------------
# Official WhatsApp number in international format, digits only (e.g. 919876543210).
# Leave blank until the client confirms the number; WhatsApp affordances are
# hidden when it is unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=
